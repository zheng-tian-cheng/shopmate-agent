      "expect": {
        "conditions": [],
        "dismissed": [],
        "rejectedOps": [
          "suggest"
        ]
      }
    },
    {
      "name": "不合法的值和类别被拒绝",
      "steps": [
        {
          "origin": "ui",
          "changes": [
            {
              "op": "set",
              "field": "budget",
              "kind": "hard",
              "value": -5
