{
  "schemaVersion": 1,
  "description": "ShopMate 购买条件与结构化筛选的规则用例。前端（TypeScript）与后端（FastAPI）实现都必须通过全部用例；规则有变化时先改这里。",
  "applyCases": [
    {
      "name": "系统建议在用户确认前不生效",
      "steps": [
        {
          "origin": "interpreter",
          "changes": [
            {
              "op": "suggest",
              "field": "anc",
              "kind": "hard",
              "value": true,
              "reason": "通勤场景通常会考虑主动降噪"
            }
          ]
        }
      ],
      "expect": {
        "conditions": [
          {
            "field": "anc",
            "status": "suggested",
            "kind": "hard",
            "source": "system",
            "value": true,
            "reason": "通勤场景通常会考虑主动降噪"
          }
        ],
        "dismissed": [],
        "rejectedOps": []
      }
    },
    {
      "name": "解析器不能替用户采纳建议",
      "steps": [
        {
          "origin": "interpreter",
          "changes": [
            {
              "op": "suggest",
              "field": "anc",
              "kind": "hard",
              "value": true,
              "reason": "通勤场景"
            }
          ]
        },
        {
          "origin": "interpreter",
          "changes": [
            {
              "op": "confirm",
              "field": "anc"
            }
          ]
        }
      ],
      "expect": {
        "conditions": [
          {
            "field": "anc",
            "status": "suggested",
            "kind": "hard",
            "source": "system",
            "value": true,
            "reason": "通勤场景"
          }
        ],
        "dismissed": [],
        "rejectedOps": [
          "confirm"
        ]
      }
    },
    {
      "name": "用户采纳后才生效，来源仍记录为系统建议",
      "steps": [
        {
          "origin": "interpreter",
          "changes": [
            {
              "op": "suggest",
              "field": "anc",
              "kind": "hard",
              "value": true,
              "reason": "通勤场景"
            }
          ]
        },
        {
          "origin": "ui",
          "changes": [
            {
              "op": "confirm",
              "field": "anc"
            }
          ]
        }
      ],
      "expect": {
        "conditions": [
          {
            "field": "anc",
            "status": "confirmed",
            "kind": "hard",
            "source": "system",
            "value": true,
            "reason": "通勤场景"
          }
        ],
        "dismissed": [],
        "rejectedOps": []
      }
    },
    {
      "name": "用户可以把建议采纳为偏好而不是硬约束",
      "steps": [
        {
          "origin": "interpreter",
          "changes": [
            {
              "op": "suggest",
              "field": "anc",
              "kind": "hard",
              "value": true,
              "reason": "通勤场景"
            }
          ]
        },
        {
          "origin": "ui",
          "changes": [
            {
              "op": "confirm",
              "field": "anc",
              "kind": "soft"
            }
          ]
        }
      ],
      "expect": {
        "conditions": [
          {
            "field": "anc",
            "status": "confirmed",
            "kind": "soft",
            "source": "system",
            "value": true,
            "reason": "通勤场景"
          }
        ],
        "dismissed": [],
        "rejectedOps": []
      }
    },
    {
      "name": "忽略过的建议在本次选购中不再提出",
      "steps": [
        {
          "origin": "interpreter",
          "changes": [
            {
              "op": "suggest",
              "field": "anc",
              "kind": "hard",
              "value": true,
              "reason": "通勤场景"
            }
          ]
        },
        {
          "origin": "ui",
          "changes": [
            {
              "op": "dismiss",
              "field": "anc"
            }
          ]
        },
        {
          "origin": "system",
          "changes": [
            {
              "op": "suggest",
              "field": "anc",
              "kind": "hard",
              "value": true,
              "reason": "再次建议"
            }
          ]
        }
      ],
      "expect": {
        "conditions": [],
        "dismissed": [
          "anc"
        ],
        "rejectedOps": [
          "suggest"
        ]
      }
    },
    {
      "name": "系统建议不覆盖用户已设置的条件",
      "steps": [
        {
          "origin": "ui",
          "changes": [
            {
              "op": "set",
              "field": "anc",
              "kind": "soft",
              "value": true
            }
          ]
        },
        {
          "origin": "system",
          "changes": [
            {
              "op": "suggest",
              "field": "anc",
              "kind": "hard",
              "value": true,
              "reason": "相似款支持主动降噪"
            }
          ]
        }
      ],
      "expect": {
        "conditions": [
          {
            "field": "anc",
            "status": "confirmed",
            "kind": "soft",
            "source": "user",
            "value": true
          }
        ],
        "dismissed": [],
        "rejectedOps": [
          "suggest"
        ]
      }
    },
    {
      "name": "只修改预算时其他条件保持不变",
      "steps": [
        {
          "origin": "interpreter",
          "changes": [
            {
              "op": "set",
              "field": "budget",
              "kind": "hard",
              "value": 300
            },
            {
              "op": "set",
              "field": "scene",
              "kind": "scene",
              "value": "地铁通勤"
            },
            {
              "op": "set",
              "field": "anc",
              "kind": "hard",
              "value": true
            }
          ]
        },
        {
          "origin": "interpreter",
          "changes": [
            {
              "op": "update",
              "field": "budget",
              "value": 200
            }
          ]
        }
      ],
      "expect": {
        "conditions": [
          {
            "field": "budget",
            "status": "confirmed",
            "kind": "hard",
            "source": "user",
            "value": 200
          },
          {
            "field": "scene",
            "status": "confirmed",
            "kind": "scene",
            "source": "user",
            "value": "地铁通勤"
          },
          {
            "field": "anc",
            "status": "confirmed",
            "kind": "hard",
            "source": "user",
            "value": true
          }
        ],
        "dismissed": [],
        "rejectedOps": []
      }
    },
    {
      "name": "待确认项不生效，用户选择后才生效",
      "steps": [
        {
          "origin": "interpreter",
          "changes": [
            {
              "op": "ask",
              "field": "budget",
              "question": "300 元是预算上限，还是大概的参考？",
              "rawText": "三百块钱",
              "options": [
                {
                  "label": "300 元以内（上限）",
                  "kind": "hard",
                  "value": 300
                },
                {
                  "label": "300 元左右（参考）",
                  "kind": "soft",
                  "value": 300
                }
              ]
            }
          ]
        },
        {
          "origin": "ui",
          "changes": [
            {
              "op": "resolve",
              "field": "budget",
              "option": 1
            }
          ]
        }
      ],
      "expect": {
        "conditions": [
          {
            "field": "budget",
            "status": "confirmed",
            "kind": "soft",
            "source": "user",
            "value": 300
          }
        ],
        "dismissed": [],
        "rejectedOps": []
      }
    },
    {
      "name": "商品列表继承的条件来源记录为 page",
      "steps": [
        {
          "origin": "page",
          "changes": [
            {
              "op": "set",
              "field": "budget",
              "kind": "hard",
              "value": 300
