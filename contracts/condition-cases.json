                  "半入耳式",
                  "头戴式"
                ]
              }
            }
          ]
        }
      ],
      "expect": {
        "conditions": [],
        "dismissed": [],
        "rejectedOps": [
          "set",
          "set",
          "set"
        ]
      }
    },
    {
      "name": "没有已生效的条件时不能修改",
