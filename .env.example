# Server only. Use an AI Studio project on the Free tier without billing enabled.
GEMINI_API_KEY=
# 已核实的免费模型：gemini-3.8-flash、gemini-3.5-flash-lite；不在名单内的模型会被拒绝，不会自动切换。
GEMINI_MODEL=gemini-3.8-flash
# Optional; browsers normally use the Next.js same-origin proxy.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
